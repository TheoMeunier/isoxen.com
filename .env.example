APP_NAME=Isoxen
APP_SLUG=isoxen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=${APP_SLUG}_database
DB_PORT=5432
DB_DATABASE=isoxen
DB_USERNAME=isoxen
DB_PASSWORD=isoxen

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=${APP_SLUG}_redis
REDIS_PASSWORD=isoxen
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- isoxen client (isoxen.com monitoring itself) ---
# Create a project in the UI, copy its ingestion token, and paste it below.
#
# The endpoint is resolved from *inside* the container, so it's the
# container's own port 80 -- not the 8000 the host maps it to. Pointing it
# at localhost:8000 fails to connect, silently.
#
# Telemetry is shipped by a queued job on its own queue, so it can never sit
# in front of the application's real work. A worker has to cover it:
#   php artisan queue:work --queue=telemetry,default
#
# OTEL_PHP_AUTOLOAD_ENABLED is deliberately absent: the client builds the
# tracer provider itself (that's the only way to swap in the queued
# transport), and two providers would fight over the global.
ISOXEN_ENABLED=false
ISOXEN_ENDPOINT=http://localhost
ISOXEN_TOKEN=proj_paste_your_token_here
ISOXEN_QUEUE=telemetry
# A literal name, not "${APP_NAME}": this one is read straight from the
# process environment by the OpenTelemetry SDK, and docker compose passes
# env_file values through without expanding them.
OTEL_SERVICE_NAME=isoxen
