{
    "name": "isoxen/laravel-client",
    "description": "Sends a Laravel application's requests, jobs, queries, exceptions, mail, notifications and more to isoxen over OpenTelemetry.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "isoxen"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "open-telemetry/api": "^1.7",
        "open-telemetry/context": "^1.4",
        "open-telemetry/sem-conv": "^1.38",
        "spatie/laravel-package-tools": "^1.16",
        "thecodingmachine/safe": "^2.0 || ^3.0"
    },
    "require-dev": {
        "laravel/octane": "^2.13",
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0",
        "livewire/livewire": "^3.0 || ^4.0",
        "mockery/mockery": "^1.6",
        "open-telemetry/exporter-otlp": "^1.3",
        "open-telemetry/sdk": "^1.9",
        "orchestra/testbench": "^9.2 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "predis/predis": "^2.2 || ^3.0"
    },
    "suggest": {
        "open-telemetry/sdk": "Required at runtime by the host application to actually export telemetry.",
        "open-telemetry/exporter-otlp": "Required at runtime to serialize telemetry as OTLP for isoxen.",
        "laravel/scout": "Required to trace Scout search operations.",
        "livewire/livewire": "Required to trace Livewire component lifecycles.",
        "predis/predis": "Required to trace Redis commands when using the predis client."
    },
    "autoload": {
        "psr-4": {
            "Isoxen\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Isoxen\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --no-coverage",
        "lint": [
            "pint",
            "phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Isoxen\\Client\\IsoxenServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
